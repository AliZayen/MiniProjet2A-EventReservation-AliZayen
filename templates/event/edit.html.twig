{% extends 'base.html.twig' %}

{% block title %}Edit event{% endblock %}

{% block body %}
  <div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h1 class="h3 mb-0">Edit event</h1>
      <div class="d-flex gap-2">
        <a class="btn btn-outline-danger" href="{{ path('app_events_show', { id: event.id }) }}">Back</a>
        <a class="btn btn-outline" href="{{ path('app_events_index') }}">All events</a>
      </div>
    </div>

    <div class="row g-4">
      <div class="col-12 col-lg-8">
        <div class="card">
          <div class="card-header">Event information</div>
          <div class="card-body">
            {{ form_start(form, { attr: { class: 'needs-validation' } }) }}
              {{ form_errors(form) }}

              <div class="table-responsive">
                <table class="table table-light text-dark border-secondary table-striped align-middle mb-0">
                  <tbody>
                    <tr>
                      <th style="width: 220px;">{{ form_label(form.title) }}</th>
                      <td>
                        {{ form_widget(form.title) }}
                        {{ form_errors(form.title) }}
                      </td>
                    </tr>
                    <tr>
                      <th>{{ form_label(form.eventDate) }}</th>
                      <td>
                        {{ form_widget(form.eventDate) }}
                        {{ form_errors(form.eventDate) }}
                      </td>
                    </tr>
                    <tr>
                      <th>{{ form_label(form.location) }}</th>
                      <td>
                        {{ form_widget(form.location) }}
                        {{ form_errors(form.location) }}
                      </td>
                    </tr>
                    <tr>
                      <th>{{ form_label(form.picture) }}</th>
                      <td>
                        {{ form_widget(form.picture) }}
                        {{ form_errors(form.picture) }}
                        <div class="form-text">Tip: paste a public image URL.</div>
                      </td>
                    </tr>
                    <tr>
                      <th>{{ form_label(form.orgnizer) }}</th>
                      <td>
                        {{ form_widget(form.orgnizer) }}
                        {{ form_errors(form.orgnizer) }}
                      </td>
                    </tr>
                    <tr>
                      <th>{{ form_label(form.ticketPrices) }}</th>
                      <td>
                        {{ form_widget(form.ticketPrices) }}
                        {{ form_errors(form.ticketPrices) }}
                        <div class="form-text">You can add one price or many (comma separated).</div>
                      </td>
                    </tr>
                    <tr>
                      <th>{{ form_label(form.tags) }}</th>
                      <td>
                        {{ form_widget(form.tags) }}
                        {{ form_errors(form.tags) }}
                        <div class="form-text">Hold Ctrl (Cmd on Mac) to select multiple tags.</div>
                      </td>
                    </tr>
                    <tr>
                      <th>{{ form_label(form.details) }}</th>
                      <td>
                        {{ form_widget(form.details) }}
                        {{ form_errors(form.details) }}
                      </td>
                    </tr>
                    <tr>
                      <th>{{ form_label(form.planning) }}</th>
                      <td>
                        {{ form_widget(form.planning) }}
                        {{ form_errors(form.planning) }}
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <div class="d-flex flex-wrap gap-2 mt-3">
                <button class="btn btn-info">Save changes</button>
                <a class="btn btn-outline-danger" href="{{ path('app_events_show', { id: event.id }) }}">Cancel</a>
              </div>
            {{ form_end(form) }}
          </div>
        </div>
      </div>

      <div class="col-12 col-lg-4">
        <div class="card mb-3">
          <div class="card-header">Preview</div>
          <div class="card-body">
            {% if event.picture %}
              <img class="img-fluid rounded mb-2" src="{{ event.picture }}" alt="event picture" />
            {% else %}
              <div class="alert alert-secondary mb-0">No picture yet.</div>
            {% endif %}
            <div class="small text-body-secondary mt-2">
              <div><strong>Title:</strong> {{ event.title }}</div>
              <div><strong>Date:</strong> {{ event.eventDate|date('m/d/Y H:i') }}</div>
              <div><strong>Location:</strong> {{ event.location }}</div>
            </div>
          </div>
        </div>

        <div class="card border-danger">
          <div class="card-header text-bg-danger">Danger zone</div>
          <div class="card-body">
            <p class="mb-2">Delete this event permanently.</p>
            <form method="post" action="{{ path('app_events_delete', { id: event.id }) }}" onsubmit="return confirm('Delete this event?');">
              <input type="hidden" name="_token" value="{{ csrf_token('delete_event_' ~ event.id) }}">
              <button class="btn btn-danger w-100">Delete event</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
{% endblock %}

