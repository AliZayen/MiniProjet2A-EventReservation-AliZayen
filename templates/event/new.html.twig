{% extends 'base.html.twig' %}

{% block title %}New event{% endblock %}

{% block body %}
  <div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h1 class="h3 mb-0">Create event</h1>
      <a class="btn btn-outline-danger" href="{{ path('app_events_index') }}">Back</a>
    </div>

    {% set pictureUrl = form.picture.vars.value %}
    {% set titleValue = form.title.vars.value %}
    {% set locationValue = form.location.vars.value %}

    <div class="row g-4">
      <div class="col-12 col-lg-8">
        <div class="card">
          <div class="card-header">Event information</div>
          <div class="card-body">
            {{ form_start(form, { attr: { class: 'needs-validation' } }) }}
              {{ form_errors(form) }}

              <div class="table-responsive">
                <table class="table table-light table-striped align-middle mb-0">
                  <tbody>
                    <tr>
                      <th style="width: 220px;">{{ form_label(form.title) }}</th>
                      <td>
                        {{ form_widget(form.title) }}
                        {{ form_errors(form.title) }}
                      </td>
                    </tr>
                    <tr>
                      <th>{{ form_label(form.eventDate) }}</th>
                      <td>
                        {{ form_widget(form.eventDate) }}
                        {{ form_errors(form.eventDate) }}
                      </td>
                    </tr>
                    <tr>
                      <th>{{ form_label(form.location) }}</th>
                      <td>
                        {{ form_widget(form.location) }}
                        {{ form_errors(form.location) }}
                      </td>
                    </tr>
                    <tr>
                      <th>{{ form_label(form.picture) }}</th>
                      <td>
                        {{ form_widget(form.picture) }}
                        {{ form_errors(form.picture) }}
                        <div class="form-text">Tip: paste a public image URL.</div>
                      </td>
                    </tr>
                    {% if form.orgnizer is defined %}
                      <tr>
                        <th>{{ form_label(form.orgnizer) }}</th>
                        <td>
                          {{ form_widget(form.orgnizer) }}
                          {{ form_errors(form.orgnizer) }}
                        </td>
                      </tr>
                    {% endif %}
                    {% if form.pinned is defined %}
                      <tr>
                        <th>{{ form_label(form.pinned) }}</th>
                        <td>
                          {{ form_widget(form.pinned) }}
                          {{ form_errors(form.pinned) }}
                          <div class="form-text">{{ form_help(form.pinned) }}</div>
                        </td>
                      </tr>
                    {% endif %}
                    <tr>
                      <th>{{ form_label(form.ticketPrices) }}</th>
                      <td>
                        {{ form_widget(form.ticketPrices) }}
                        {{ form_errors(form.ticketPrices) }}
                        <div class="form-text">You can add one price or many (comma separated).</div>
                      </td>
                    </tr>
                    <tr>
                      <th>{{ form_label(form.tags) }}</th>
                      <td>
                        {{ form_widget(form.tags) }}
                        {{ form_errors(form.tags) }}
                        <div class="form-text">Hold Ctrl (Cmd on Mac) to select multiple tags.</div>
                      </td>
                    </tr>
                    <tr>
                      <th>{{ form_label(form.details) }}</th>
                      <td>
                        {{ form_widget(form.details) }}
                        {{ form_errors(form.details) }}
                      </td>
                    </tr>
                    <tr>
                      <th>{{ form_label(form.planning) }}</th>
                      <td>
                        {{ form_widget(form.planning) }}
                        {{ form_errors(form.planning) }}
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <div class="d-flex flex-wrap gap-2 mt-3">
                <button class="btn btn-primary">Create event</button>
                <a class="btn btn-outline-light" href="{{ path('app_events_index') }}">Cancel</a>
              </div>
            {{ form_end(form) }}
          </div>
        </div>
      </div>

      <div class="col-12 col-lg-4">
        <div class="card">
          <div class="card-header">Preview</div>
          <div class="card-body">
            {% if pictureUrl %}
              <img class="img-fluid rounded mb-2" src="{{ pictureUrl }}" alt="event picture" />
            {% else %}
              <div class="alert alert-secondary mb-0">No picture yet.</div>
            {% endif %}
            <div class="small text-body-secondary mt-2">
              <div><strong>Title:</strong> {{ titleValue ?: '—' }}</div>
              <div><strong>Date:</strong> {{ form.eventDate.vars.value ? (form.eventDate.vars.value|date('m/d/Y H:i')) : '—' }}</div>
              <div><strong>Location:</strong> {{ locationValue ?: '—' }}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
{% endblock %}

