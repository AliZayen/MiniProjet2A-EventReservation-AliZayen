{% extends 'base.html.twig' %}

{% block title %}{{ event.title }}{% endblock %}

{% block body %}
  <div class="container my-4">
    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
      <div>
        <h1 class="h3 mb-1">{{ event.title }}</h1>
        <div class="text-body-secondary">
          <div><strong>Date:</strong> {{ event.eventDate|date('m/d/Y H:i') }}</div>
          <div><strong>Location:</strong> {{ event.location }}</div>
          <div><strong>Organizer:</strong> {{ event.orgnizer }}</div>
          <div><strong>Ticket prices:</strong> {{ event.ticketPrices ?: '—' }}</div>
          <div>
            <strong>Tags:</strong>
            {% if event.tags is empty %}
              —
            {% else %}
              {% for tag in event.tags %}
                <span class="badge bg-primary-subtle text-primary-emphasis">{{ tag.name }}</span>
              {% endfor %}
            {% endif %}
          </div>
          <div><strong>Created at:</strong> {{ event.createdAt ? event.createdAt|date('m/d/Y H:i') : '—' }}</div>
          <div><strong>Updated at:</strong> {{ event.updatedAt ? event.updatedAt|date('m/d/Y H:i') : '—' }}</div>
        </div>
      </div>

      <div class="d-flex gap-2">
        <a class="btn btn-outline-light" href="{{ path('app_events_index') }}">Back</a>
        <a class="btn btn-info" href="{{ path('app_events_edit', { id: event.id }) }}">Edit</a>
      </div>
    </div>

    {% if event.picture %}
      <img class="img-fluid rounded mb-3" src="{{ event.picture }}" alt="event picture" />
    {% endif %}

    <div class="card mb-3">
      <div class="card-header">Details</div>
      <div class="card-body">
        <p class="mb-0">{{ event.details ?: '—' }}</p>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-header">Planning</div>
      <div class="card-body">
        <p class="mb-0">{{ event.planning ?: '—' }}</p>
      </div>
    </div>

    <form method="post" action="{{ path('app_events_delete', { id: event.id }) }}" onsubmit="return confirm('Delete this event?');">
      <input type="hidden" name="_token" value="{{ csrf_token('delete_event_' ~ event.id) }}">
      <button class="btn btn-danger">Delete</button>
    </form>
  </div>
{% endblock %}