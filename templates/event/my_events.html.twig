{% extends 'base.html.twig' %}

{% block title %}My events{% endblock %}

{% block body %}
  <div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h1 class="h3 mb-0"><i class="bi bi-collection me-2 text-primary" aria-hidden="true"></i>My events</h1>
      <a class="btn btn-primary" href="{{ path('app_events_new') }}"><i class="bi bi-plus-circle me-1" aria-hidden="true"></i>New event</a>
    </div>

    <div class="row g-4">
      <div class="col-12 col-lg-6">
        <div class="card h-100">
          <div class="card-header">Approved events</div>
          <div class="card-body">
            {% if approved_events is empty %}
              <div class="alert alert-secondary mb-0"><i class="bi bi-inbox me-2" aria-hidden="true"></i>No approved events yet.</div>
            {% else %}
              <div class="list-group">
                {% for event in approved_events %}
                  <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <a href="{{ path('app_events_show', { id: event.id }) }}" class="text-decoration-none flex-grow-1">
                      <strong>{{ event.title }}</strong><br>
                      <small class="text-body-secondary">{{ event.eventDate|date('m/d/Y H:i') }}</small>
                    </a>
                    <div class="d-flex align-items-center gap-2">
                      <span class="badge bg-success"><i class="bi bi-check-lg me-1" aria-hidden="true"></i>Approved</span>
                      <a class="btn btn-outline-info btn-sm" href="{{ path('app_event_registrations', { id: event.id }) }}"><i class="bi bi-people me-1" aria-hidden="true"></i>Registrations</a>
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="col-12 col-lg-6">
        <div class="card h-100">
          <div class="card-header"><i class="bi bi-hourglass-split me-2 text-warning" aria-hidden="true"></i>Pending approval</div>
          <div class="card-body">
            {% if pending_events is empty %}
              <div class="alert alert-secondary mb-0"><i class="bi bi-inbox me-2" aria-hidden="true"></i>No pending events.</div>
            {% else %}
              <div class="list-group">
                {% for event in pending_events %}
                  <a href="{{ path('app_events_show', { id: event.id }) }}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <span>
                      <strong>{{ event.title }}</strong><br>
                      <small class="text-body-secondary">{{ event.eventDate|date('m/d/Y H:i') }}</small>
                    </span>
                    <span class="badge bg-warning text-dark"><i class="bi bi-clock-history me-1" aria-hidden="true"></i>Pending</span>
                  </a>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
{% endblock %}

