{% extends 'base.html.twig' %}

{% block title %}Events{% endblock %}

{% block body %}
  <div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h1 class="h3 mb-0"><i class="bi bi-calendar-event me-2 text-info" aria-hidden="true"></i>Events</h1>
      {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ORGANIZER') %}
        <a class="btn btn-primary" href="{{ path('app_events_new') }}"><i class="bi bi-plus-circle me-1" aria-hidden="true"></i>New event</a>
      {% endif %}
    </div>

    <form method="get" action="{{ path('app_events_index') }}" class="card card-body mb-3">
      <div class="row g-2 align-items-end">
        <div class="col-12 col-md-6">
          <label for="event-search" class="form-label mb-1"><i class="bi bi-search me-1" aria-hidden="true"></i>Search <small class="text-body-secondary">(Title, location, organizer)</small></label>
          <input
            id="event-search"
            name="q"
            type="text"
            value="{{ filters.q|default('') }}"
            class="form-control bg-dark text-light border-secondary"
            placeholder="Title, location, organizer..."
          >
        </div>
        <div class="col-12 col-md-4">
          <label for="event-status" class="form-label mb-1"><i class="bi bi-funnel me-1" aria-hidden="true"></i>Status</label>
          <select id="event-status" name="status" class="form-select bg-dark text-light border-secondary">
            <option value="all" {{ (filters.status|default('all')) == 'all' ? 'selected' : '' }}>All</option>
            <option value="today" {{ (filters.status|default('all')) == 'today' ? 'selected' : '' }}>Today</option>
            <option value="upcoming" {{ (filters.status|default('all')) == 'upcoming' ? 'selected' : '' }}>Upcoming</option>
            <option value="passed" {{ (filters.status|default('all')) == 'passed' ? 'selected' : '' }}>Passed</option>
          </select>
        </div>
        <div class="col-12 col-md-2 d-flex gap-2">
          <button class="btn btn-info w-100" type="submit"><i class="bi bi-sliders me-1" aria-hidden="true"></i>Filter</button>
          <a class="btn btn-outline-secondary" href="{{ path('app_events_index') }}">Reset</a>
        </div>
      </div>
    </form>

    {% if is_granted('ROLE_ADMIN') and pinned_events is not empty %}
      <div class="row g-3 mb-2">
        <div class="col-12">
          <h2 class="h4 mt-2 mb-1"><i class="bi bi-pin-angle-fill me-2 text-warning" aria-hidden="true"></i>Pinned events</h2>
          <hr class="mt-0 mb-2" />
        </div>
        {% for event in pinned_events %}
          <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 border-warning">
              {% if event.picture %}
                <img class="card-img-top" src="{{ event.picture }}" alt="event picture" style="object-fit: cover; height: 200px;" />
              {% endif %}
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <h2 class="h5 card-title mb-0">{{ event.title }}</h2>
                  <div class="d-flex gap-1">
                    <span class="badge bg-warning text-dark"><i class="bi bi-pin-angle me-1" aria-hidden="true"></i>Pinned</span>
                    {% if not event.accepted %}
                      <span class="badge bg-secondary"><i class="bi bi-hourglass-split me-1" aria-hidden="true"></i>Pending</span>
                    {% endif %}
                  </div>
                </div>
                <div class="small text-body-secondary mb-2">
                  <div><i class="bi bi-clock me-1" aria-hidden="true"></i>{{ event.eventDate|date('m/d/Y H:i') }}</div>
                  <div><i class="bi bi-geo-alt me-1" aria-hidden="true"></i>{{ event.location }}</div>
                </div>
                <a class="btn btn-outline-primary btn-sm" href="{{ path('app_events_show', { id: event.id }) }}"><i class="bi bi-eye me-1" aria-hidden="true"></i>Details</a>
                <a class="btn btn-outline-info btn-sm" href="{{ path('app_events_edit', { id: event.id }) }}"><i class="bi bi-pencil me-1" aria-hidden="true"></i>Edit</a>
                {% if not event.accepted %}
                  <form method="post" action="{{ path('app_events_accept', { id: event.id }) }}" class="d-inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('accept_event_' ~ event.id) }}">
                    <button class="btn btn-outline-success btn-sm" type="submit"><i class="bi bi-check2-circle me-1" aria-hidden="true"></i>Accept</button>
                  </form>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if events is empty %}
      <div class="alert alert-info">No events found.</div>
    {% else %}
      <div class="row g-3">
        {% set previousStatus = null %}
        {% for event in events %}
          {% set now = 'now'|date('Y-m-d') %}
          {% set eventDay = event.eventDate|date('Y-m-d') %}
          {% if eventDay == now %}
            {% set status = 'today' %}
          {% elseif eventDay > now %}
            {% set status = 'upcoming' %}
          {% else %}
            {% set status = 'passed' %}
          {% endif %}

          {% if previousStatus != status %}
            <div class="col-12">
              {% if status == 'today' %}
                <h2 class="h4 mt-2 mb-1"><i class="bi bi-sun-fill me-2 text-success" aria-hidden="true"></i>Today's events</h2>
              {% elseif status == 'upcoming' %}
                <h2 class="h4 mt-4 mb-1"><i class="bi bi-calendar-plus me-2 text-primary" aria-hidden="true"></i>Upcoming events</h2>
              {% else %}
                <h2 class="h4 mt-4 mb-1"><i class="bi bi-calendar-x me-2 text-secondary" aria-hidden="true"></i>Passed events</h2>
              {% endif %}
              <hr class="mt-0 mb-2" />
            </div>
          {% endif %}
          {% set previousStatus = status %}

          <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100">
              {% if event.picture %}
                <img class="card-img-top" src="{{ event.picture }}" alt="event picture" style="object-fit: cover; height: 200px;" />
              {% endif %}
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <h2 class="h5 card-title mb-0">{{ event.title }}</h2>
                  <div class="d-flex gap-1">
                    {% if status == 'today' %}
                      <span class="badge bg-success"><i class="bi bi-sun-fill me-1" aria-hidden="true"></i>Today</span>
                    {% elseif status == 'upcoming' %}
                      <span class="badge bg-primary"><i class="bi bi-calendar-plus me-1" aria-hidden="true"></i>Upcoming</span>
                    {% else %}
                      <span class="badge bg-secondary"><i class="bi bi-calendar-x me-1" aria-hidden="true"></i>Passed</span>
                    {% endif %}
                    {% set canSeeApproval = is_granted('ROLE_ADMIN') or (is_granted('ROLE_ORGANIZER') and app.user and event.organizerId == app.user.id) %}
                    {% if canSeeApproval and not event.accepted %}
                      <span class="badge bg-warning text-dark">Pending</span>
                    {% endif %}
                  </div>
                </div>
                <div class="small text-body-secondary mb-2">
                  <div><i class="bi bi-clock me-1" aria-hidden="true"></i>{{ event.eventDate|date('m/d/Y H:i') }}</div>
                  <div><i class="bi bi-geo-alt me-1" aria-hidden="true"></i>{{ event.location }}</div>
                </div>
                <a class="btn btn-outline-primary btn-sm" href="{{ path('app_events_show', { id: event.id }) }}"><i class="bi bi-eye me-1" aria-hidden="true"></i>Details</a>
                {% set canManage = is_granted('ROLE_ADMIN') or (is_granted('ROLE_ORGANIZER') and app.user and event.organizerId == app.user.id) %}
                {% if canManage %}
                  <a class="btn btn-outline-info btn-sm" href="{{ path('app_events_edit', { id: event.id }) }}"><i class="bi bi-pencil me-1" aria-hidden="true"></i>Edit</a>
                {% endif %}
                {% if is_granted('ROLE_ADMIN') and not event.accepted %}
                  <form method="post" action="{{ path('app_events_accept', { id: event.id }) }}" class="d-inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('accept_event_' ~ event.id) }}">
                    <button class="btn btn-outline-success btn-sm" type="submit"><i class="bi bi-check2-circle me-1" aria-hidden="true"></i>Accept</button>
                  </form>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
{% endblock %}
