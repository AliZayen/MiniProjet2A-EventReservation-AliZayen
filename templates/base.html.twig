<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Welcome!{% endblock %}</title>

        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5/dist/cyborg/bootstrap.min.css">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    </head>
    <body>
        <nav class="navbar navbar-expand-lg bg-dark" data-bs-theme="dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="{{ path('app_home') }}">MyEvent</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor02" aria-controls="navbarColor02" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse " id="navbarColor02">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                <a class="nav-link" href="{{ path('app_home') }}">Home</a>
                </li>
                <li class="nav-item">
                <a class="nav-link" href="{{ path('app_events_index') }}">Events</a>
                </li>
                {% if is_granted('ROLE_PARTICIPANT') %}
                <li class="nav-item">
                  <a class="nav-link" href="{{ path('app_registrations_my') }}"><i class="bi bi-bookmark-check me-1" aria-hidden="true"></i>My registrations</a>
                </li>
                {% endif %}
                {% if is_granted('ROLE_ORGANIZER') %}
                <li class="nav-item">
                  <a class="nav-link" href="{{ path('app_events_my') }}"><i class="bi bi-collection me-1" aria-hidden="true"></i>My events</a>
                </li>
                {% endif %}
                {% if is_granted('ROLE_ADMIN') %}
                <li class="nav-item">
                  <a class="nav-link" href="{{ path('app_admin_registrations') }}">Registrations</a>
                </li>
                <li class="nav-item">
                  <a class="nav-link" href="{{ path('app_users_index') }}">Users</a>
                </li>
                {% endif %}
            </ul>

            <div class="d-flex align-items-center gap-2">
              {% if app.user %}
                <span class="small text-white-50 d-none d-md-inline">{{ app.user.userIdentifier }}</span>
                <form method="post" action="{{ path('app_logout') }}" class="mb-0">
                  <button class="btn btn-danger btn-sm" type="submit"><i class="bi bi-box-arrow-left me-1" aria-hidden="true"></i>Sign out</button>
                </form>
              {% else %}
                <a class="btn btn-outline-dark btn-sm" href="{{ path('app_register') }}"><i class="bi bi-person-plus me-1" aria-hidden="true"></i>Sign up</a>
                <a class="btn btn-success btn-sm" href="{{ path('app_login') }}"><i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>Sign in</a>
              {% endif %}
            </div>
            </div>
        </div>
        </nav>

        {% for label, messages in app.flashes %}
          {% for message in messages %}
            <div class="container mt-3">
              <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
              </div>
            </div>
          {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </body>
</html>
