{% extends 'base.html.twig' %}

{% block title %}Registrations — {{ event.title }}{% endblock %}

{% block body %}
  <div class="container my-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
      <div>
        <h1 class="h3 mb-2"><i class="bi bi-people me-2" aria-hidden="true"></i>Registrations</h1>
        <p class="text-body-secondary mb-0"><strong>Event:</strong> {{ event.title }}</p>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" href="{{ path('app_events_show', { id: event.id }) }}"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Event</a>
        <a class="btn btn-success" href="{{ path('app_event_registrations_export', { id: event.id }) }}"><i class="bi bi-download me-1" aria-hidden="true"></i>Export CSV</a>
      </div>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-6 col-md-3">
        <div class="card h-100">
          <div class="card-body py-3">
            <div class="small text-body-secondary">Total</div>
            <div class="h4 mb-0">{{ stats.total }}</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card h-100 border-success">
          <div class="card-body py-3">
            <div class="small text-body-secondary">Paid</div>
            <div class="h4 mb-0 text-success">{{ stats.paid }}</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card h-100 border-warning">
          <div class="card-body py-3">
            <div class="small text-body-secondary">Not paid</div>
            <div class="h4 mb-0 text-warning">{{ stats.unpaid }}</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card h-100 border-info">
          <div class="card-body py-3">
            <div class="small text-body-secondary">Today</div>
            <div class="h4 mb-0">{{ stats.today }}</div>
          </div>
        </div>
      </div>
    </div>

    {% if registrations is empty %}
      <div class="alert alert-secondary">No registrations for this event.</div>
    {% else %}
      <div class="table-responsive card">
        <table class="table table-striped align-middle mb-0">
          <thead>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Phone</th>
              <th>Ticket</th>
              <th>Payment</th>
              <th>Reserved</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {% for r in registrations %}
              <tr>
                <td>{{ r.user.fullName }}</td>
                <td>{{ r.user.email }}</td>
                <td>{{ r.user.phoneNumber ?: '—' }}</td>
                <td>{{ r.ticketType }}</td>
                <td>
                  {% if r.paymentStatus == 'paid' %}
                    <span class="badge bg-success">Paid</span>
                  {% else %}
                    <span class="badge bg-secondary">Not paid</span>
                  {% endif %}
                </td>
                <td>{{ r.reservedAt|date('m/d/Y H:i') }}</td>
                <td>
                  <form method="post" action="{{ path('app_registration_payment', { id: r.id }) }}" class="d-inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('registration_payment_' ~ r.id) }}">
                    {% if r.paymentStatus == 'paid' %}
                      <input type="hidden" name="payment_status" value="unpaid">
                      <button class="btn btn-outline-warning btn-sm" type="submit">Mark not paid</button>
                    {% else %}
                      <input type="hidden" name="payment_status" value="paid">
                      <button class="btn btn-outline-success btn-sm" type="submit">Mark paid</button>
                    {% endif %}
                  </form>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </div>
{% endblock %}
