{% extends 'base.html.twig' %}

{% block title %}All registrations{% endblock %}

{% block body %}
  <div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h1 class="h3 mb-0"><i class="bi bi-database me-2" aria-hidden="true"></i>All registrations</h1>
      <a class="btn btn-outline-secondary" href="{{ path('app_home') }}"><i class="bi bi-house-door me-1" aria-hidden="true"></i>Home</a>
    </div>

    {% if registrations is empty %}
      <div class="alert alert-secondary">No registrations in the database.</div>
    {% else %}
      <div class="table-responsive card">
        <table class="table table-striped align-middle mb-0 small">
          <thead>
            <tr>
              <th>ID</th>
              <th>Event</th>
              <th>Participant</th>
              <th>Email</th>
              <th>Ticket</th>
              <th>Payment</th>
              <th>Reserved</th>
            </tr>
          </thead>
          <tbody>
            {% for r in registrations %}
              <tr>
                <td>{{ r.id }}</td>
                <td><a href="{{ path('app_events_show', { id: r.event.id }) }}">{{ r.event.title }}</a></td>
                <td>{{ r.user.fullName }}</td>
                <td>{{ r.user.email }}</td>
                <td>{{ r.ticketType }}</td>
                <td>{{ r.paymentStatus }}</td>
                <td>{{ r.reservedAt|date('m/d/Y H:i') }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </div>
{% endblock %}
