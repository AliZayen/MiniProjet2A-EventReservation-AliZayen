{% extends 'base.html.twig' %}

{% block title %}User #{{ userEntity.id }}{% endblock %}

{% block body %}
  <div class="container my-4" style="max-width: 920px;">
    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
      <div>
        <h1 class="h3 mb-1">{{ userEntity.fullName }}</h1>
        <div class="text-body-secondary">
          <div><strong>Email:</strong> {{ userEntity.email }}</div>
          <div><strong>Type:</strong> {{ userEntity.type }}</div>
          <div><strong>Roles:</strong> {{ userEntity.roles|join(', ') }}</div>
        </div>
      </div>

      <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="{{ path('app_users_index') }}">Back</a>
        <a class="btn btn-info" href="{{ path('app_users_edit', { id: userEntity.id }) }}">Edit</a>
      </div>
    </div>

    <div class="card">
      <div class="card-header">Delete</div>
      <div class="card-body">
        <form method="post" action="{{ path('app_users_delete', { id: userEntity.id }) }}" onsubmit="return confirm('Delete this user?');">
          <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ userEntity.id) }}">
          <button class="btn btn-danger">Delete user</button>
        </form>
      </div>
    </div>
  </div>
{% endblock %}

