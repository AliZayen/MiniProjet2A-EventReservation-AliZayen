{% extends 'base.html.twig' %}

{% block title %}User #{{ userEntity.id }}{% endblock %}

{% block body %}
  <div class="container my-4" style="max-width: 920px;">
    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
      <div>
        <h1 class="h3 mb-1"><i class="bi bi-person-circle me-2 text-primary" aria-hidden="true"></i>{{ userEntity.fullName }}</h1>
        <div class="text-body-secondary">
          <div><i class="bi bi-envelope me-2" aria-hidden="true"></i><strong>Email:</strong> {{ userEntity.email }}</div>
          <div><i class="bi bi-tag me-2" aria-hidden="true"></i><strong>Type:</strong> {{ userEntity.type }}</div>
          {% if userEntity.type == 'organizer' %}
            <div>
              <strong>Organizer approval:</strong>
              {% if userEntity.organizerApproved %}
                <span class="badge bg-success">Approved</span>
              {% else %}
                <span class="badge bg-warning text-dark">Pending</span>
              {% endif %}
            </div>
          {% endif %}
          <div><i class="bi bi-key me-2" aria-hidden="true"></i><strong>Roles:</strong> {{ userEntity.roles|join(', ') }}</div>
        </div>
      </div>

      <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" href="{{ path('app_users_index') }}"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back</a>
        <a class="btn btn-info" href="{{ path('app_users_edit', { id: userEntity.id }) }}"><i class="bi bi-pencil me-1" aria-hidden="true"></i>Edit</a>
        {% if userEntity.type == 'organizer' and not userEntity.organizerApproved %}
          <form method="post" action="{{ path('app_users_approve_organizer', { id: userEntity.id }) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('approve_organizer_' ~ userEntity.id) }}">
            <button class="btn btn-success" type="submit"><i class="bi bi-check2-circle me-1" aria-hidden="true"></i>Approve organizer</button>
          </form>
        {% endif %}
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-header"><i class="bi bi-info-circle me-2" aria-hidden="true"></i>Profile</div>
      <div class="card-body text-body-secondary">
        <div class="row g-2">
          <div class="col-md-6"><strong>Phone:</strong> {{ userEntity.phoneNumber ?: '—' }}</div>
          <div class="col-md-6"><strong>Profession:</strong> {{ userEntity.profession ?: '—' }}</div>
          <div class="col-12"><strong>Address:</strong> {{ userEntity.address ?: '—' }}</div>
          <div class="col-md-6"><strong>Birth date:</strong> {{ userEntity.birthDate ? userEntity.birthDate|date('m/d/Y') : '—' }}</div>
          <div class="col-md-6"><strong>Website:</strong> {{ userEntity.website ?: '—' }}</div>
          <div class="col-md-6"><strong>Facebook:</strong> {{ userEntity.facebook ?: '—' }}</div>
          <div class="col-md-6"><strong>Instagram:</strong> {{ userEntity.instagram ?: '—' }}</div>
          <div class="col-md-6"><strong>WhatsApp:</strong> {{ userEntity.whatsapp ?: '—' }}</div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><i class="bi bi-trash me-2" aria-hidden="true"></i>Delete</div>
      <div class="card-body">
        <form method="post" action="{{ path('app_users_delete', { id: userEntity.id }) }}" onsubmit="return confirm('Delete this user?');">
          <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ userEntity.id) }}">
          <button class="btn btn-danger" type="submit"><i class="bi bi-trash me-1" aria-hidden="true"></i>Delete user</button>
        </form>
      </div>
    </div>
  </div>
{% endblock %}
