{% extends 'base.html.twig' %}

{% block title %}Users{% endblock %}

{% block body %}
  <div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h1 class="h3 mb-0">Users</h1>
      <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="{{ path('app_home') }}">Home</a>
        <a class="btn btn-primary" href="{{ path('app_users_new') }}">New user</a>
      </div>
    </div>

    <div class="card">
      <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
          <thead>
            <tr>
              <th style="width: 80px;">ID</th>
              <th>Full name</th>
              <th>Email</th>
              <th style="width: 160px;">Type</th>
              <th style="width: 220px;">Roles</th>
              <th style="width: 180px;"></th>
            </tr>
          </thead>
          <tbody>
          {% for user in users %}
            <tr>
              <td>{{ user.id }}</td>
              <td>{{ user.fullName }}</td>
              <td>{{ user.email }}</td>
              <td>
                {% if user.type == 'admin' %}
                  <span class="badge bg-danger">Admin</span>
                {% elseif user.type == 'organizer' %}
                  <span class="badge bg-info">Organizer</span>
                {% else %}
                  <span class="badge bg-secondary">Participant</span>
                {% endif %}
              </td>
              <td class="small text-body-secondary">
                {{ user.roles|join(', ') }}
              </td>
              <td class="text-end">
                <a class="btn btn-outline-primary btn-sm" href="{{ path('app_users_show', { id: user.id }) }}">Show</a>
                <a class="btn btn-outline-info btn-sm" href="{{ path('app_users_edit', { id: user.id }) }}">Edit</a>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="6">
                <div class="p-3">No users found.</div>
              </td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
{% endblock %}

